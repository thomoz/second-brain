[Unit]
Description=Superinvestor Fast-Disclosure Filings Scan (SEC EDGAR leg)
After=network.target

[Service]
Type=oneshot
User=secondbrain
WorkingDirectory=/home/secondbrain/second-brain/investments/superinvestor-filings
ExecStart=/home/secondbrain/second-brain/investments/.venv/bin/python -m superinvestor_filings.main scan --edgar-only
StandardOutput=append:/home/secondbrain/second-brain/investments/superinvestor-filings/superinvestor_edgar_runs.log
StandardError=append:/home/secondbrain/second-brain/investments/superinvestor-filings/superinvestor_edgar_runs.log
